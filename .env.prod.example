# 复制为 .env.prod 后填写真实值，勿提交到 Git
# cp .env.prod.example .env.prod

# 对外 HTTP 端口（web 容器）
HTTP_PORT=80

# 七牛云对象存储
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key
QINIU_BUCKET=sxak-oss
QINIU_DOMAIN=http://oss.sxakgs.com
QINIU_PREFIX=en

# DeepSeek 查词
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LOOKUP_CACHE_TTL_DAYS=30

# JWT（生产环境务必更换）
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# 管理后台默认账号（启动时自动创建/更新）
ADMIN_EMAIL=admin@vloglish.com
ADMIN_PASSWORD=change-me-strong-password

# 站点地址（密码重置链接等）
FRONTEND_URL=http://localhost
APP_DEBUG=false

# 可选：SQLite 自定义路径（默认 /app/backend/data/teco.db）
# DATABASE_URL=sqlite:////app/backend/data/teco.db

# 可选：管理端媒体抓取（容器内已预装 yt-dlp / ffmpeg）
# VLOGISH_TOOLS_DIR=/usr/bin
# YT_DLP_BIN=/usr/local/bin/yt-dlp
# FFMPEG_DIR=/usr/bin
# YT_DLP_COOKIES=/app/backend/data/cookies.txt
# YT_DLP_TIMEOUT=900

# 可选：SMTP 发信
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@vloglish.com
# SMTP_USE_TLS=true
