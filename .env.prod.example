# 复制为 .env.prod 后填写真实值，勿提交到 Git
# cp .env.prod.example .env.prod

# 对外 HTTP / HTTPS 端口（web 容器内 nginx 终结 TLS）
HTTP_PORT=80
HTTPS_PORT=443

# 站点域名（主站 HTTPS：en.yunankexun.com，证书放仓库根目录 cert/）
# SITE_DOMAIN=en.yunankexun.com
# 证书文件名：cert/en.yunankexun.com.pem、cert/en.yunankexun.com.key（已 gitignore，部署时需放到服务器）
# nginx：http://域名、IP 访问会 301 到 https://en.yunankexun.com（见 frontend/nginx.conf）
# 介绍落地页：vloglish.cc（当前仅 HTTP；若要用 HTTPS 需另备证书并改 nginx）
# 注意：nginx 已配置 HTTPS 时，不要再启用 compose 的 caddy https profile（端口冲突）

# 阿里云容器镜像服务 ACR（Gitee Go 构建推送 + 服务器拉取）
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace
ACR_USERNAME=your_acr_username
ACR_PASSWORD='your_acr_password'
# 由 deploy/update.sh 或流水线注入，首次可留 latest
IMAGE_TAG=latest
BACKEND_IMAGE=
WEB_IMAGE=

# PostgreSQL（db 容器）
POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine
POSTGRES_USER=postgres
# 含 # $ ! 等特殊字符时请用单引号包裹
POSTGRES_PASSWORD='your_strong_password'
POSTGRES_DB=postgres
# 本机/外网连库：127.0.0.1:5432 仅 ECS 本机（配合 SSH 隧道，推荐）
# 外网直连：0.0.0.0:5432，并在阿里云安全组放行 TCP 5432（仅限你的 IP）
POSTGRES_PUBLISH=127.0.0.1:5432
# Docker 内 backend 连接 db；密码含特殊字符时请 URL 编码后写入 DATABASE_URL
# 例：G7#kLp$Qw9!zR → G7%23kLp%24Qw9%21zR
DATABASE_URL=postgresql+psycopg://postgres:your_url_encoded_password@db:5432/postgres

# Redis（词卡跨用户热缓存；compose 已含 redis 服务）
REDIS_IMAGE=redis:7-alpine
# 国内镜像可改：REDIS_IMAGE=docker.1ms.run/library/redis:7-alpine
REDIS_PUBLISH=127.0.0.1:6379
REDIS_URL=redis://redis:6379/0
# 词卡 Redis TTL 秒数，0=不过期（改字幕时会主动删除）
WORD_CARDS_REDIS_TTL_SECONDS=0

# 七牛云对象存储
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key
QINIU_BUCKET=sxak-oss
QINIU_DOMAIN=http://oss.sxakgs.com
QINIU_PREFIX=en
# 对外下发短时签名 URL（默认开启）。空间改为「私有」后未签名直链将无法访问。
# 若开启七牛 Referer 防盗链：白名单加 en.yunankexun.com，并勾选「允许空 Referer」，
# 否则 Android App 的图片/视频会被 403。
QINIU_SIGN_URLS=1
# 正片音视频签名有效期（秒），默认 4 小时
QINIU_MEDIA_EXPIRES=14400
# 封面签名有效期（秒），默认 24 小时
QINIU_COVER_EXPIRES=86400

# 导入品牌化：视频默认加 vloglish 水印；封面默认不加
VLOGISH_ADD_WATERMARK=true
VLOGISH_WATERMARK_COVER=false
VLOGISH_WATERMARK_TEXT=vloglish

# DeepSeek 查词
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LOOKUP_CACHE_TTL_DAYS=30

# 阿里云智能科教口语评测（可选；未配置时跟读回退 ASR+LLM）
# 控制台获取 AppKey / AppSecret，并将 engine.js 放到 frontend/public/sdk/
# ORAL_EVAL_ENABLED=true
# ORAL_EVAL_APP_ID=a0008x7
# ORAL_EVAL_APP_SECRET=a0008x7
# ORAL_EVAL_SDK_URL=/sdk/engine.js
# ORAL_EVAL_ACCENT=am
# ORAL_EVAL_WARRANT_SECONDS=7200
# ORAL_EVAL_AUTH_URLS=https://api.cloud.ssapi.cn/auth/authorize,https://gate-01.api.cloud.ssapi.cn/auth/authorize

# 微信小程序登录
# WECHAT_MINI_APPID=
# WECHAT_MINI_SECRET=
# 小程序码环境：release | trial | develop（开发版扫码用 develop）
# WECHAT_MINI_QR_ENV=release
# 个人主体虚拟支付（MP → 虚拟支付 → 基本配置）
# 类目需含「工具」；全终端月支付限额 10 万元
# WECHAT_XPAY_OFFER_ID=
# WECHAT_XPAY_APP_KEY=
# 道具 ID 须与 MP「道具管理」里已发布的一致，价格分别为 29 / 59 / 99 元；测试档 1 分
# WECHAT_XPAY_PRODUCT_QUARTER=member_quarter
# WECHAT_XPAY_PRODUCT_YEAR=member_year
# WECHAT_XPAY_PRODUCT_FOREVER=member_forever
# WECHAT_XPAY_PRODUCT_TEST=member_test
# 发货推送 URL：https://你的域名/api/wxpay/deliver/

# JWT（生产环境务必更换）
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=720
JWT_REFRESH_EXPIRE_DAYS=30

# 管理后台默认账号（启动时自动创建/更新）
ADMIN_EMAIL=admin@vloglish.com
ADMIN_PASSWORD=change-me-strong-password

# 站点地址（密码重置链接等）
FRONTEND_URL=http://localhost
APP_DEBUG=false

# 可选：管理端媒体抓取（容器内已预装 yt-dlp / ffmpeg）
# VLOGISH_TOOLS_DIR=/usr/bin
# YT_DLP_BIN=/usr/local/bin/yt-dlp
# FFMPEG_DIR=/usr/bin
# YT_DLP_COOKIES=/app/backend/data/cookies.txt
# YT_DLP_TIMEOUT=14400
# YT_DLP_CONCURRENT_FRAGMENTS=2
# YouTube：优先 web_embedded（不需 PO Token，googlevideo 不易 403）
# YT_DLP_PLAYER_CLIENT=web_embedded,-android_sdkless,-web,-tv,-mweb
# YouTube 默认不带 cookies（登录态 + 代理 IP 常 403）。仅年龄限制片再打开：
# YT_DLP_YOUTUBE_COOKIES=1
# 比 cookies.txt 更稳：从本机浏览器读登录态（仍建议同时设 YT_DLP_YOUTUBE_COOKIES=1）
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# YouTube 解签名：deno 或 node（不填则自动检测）
# YT_DLP_JS_RUNTIME=deno
# 国内服务器抓取 TikTok/YouTube 需代理，或改在本地 Windows 抓取后上传七牛
# YT_DLP_PROXY=http://127.0.0.1:7890
# YouTube 默认会 --impersonate chrome；设 0 可关闭
# YT_DLP_IMPERSONATE=chrome

# 可选：SMTP 发信
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@vloglish.com
# SMTP_USE_TLS=true
