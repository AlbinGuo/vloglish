<view class="page">
  <text class="lead">电脑上没有扫码时再用：填写网页注册的邮箱和密码，进度和会员会并到同一个账号。</text>
  <input class="input" placeholder="邮箱" value="{{email}}" bindinput="onEmail" />
  <input class="input" password placeholder="密码" value="{{password}}" bindinput="onPassword" />
  <button class="primary" loading="{{submitting}}" bindtap="onSubmit">关联账号</button>
</view>
