<view class="page">
  <text wx:if="{{busy}}" class="lead">正在绑定网页账号…</text>
  <block wx:elif="{{done}}">
    <text class="title">绑定成功</text>
    <text class="lead">小程序和网页已经是同一个账号。回到电脑刷新即可。</text>
    <text class="action" bindtap="onHome">回到我的</text>
  </block>
  <block wx:else>
    <text class="title">绑定失败</text>
    <text class="lead">{{error}}</text>
    <text class="action" bindtap="onHome">回到我的</text>
  </block>
</view>
