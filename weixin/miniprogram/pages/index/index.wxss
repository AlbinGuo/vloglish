.page {
  padding: 8rpx 28rpx 56rpx;
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: #78716c;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.hero-lead {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #57534e;
}

.state {
  padding: 96rpx 24rpx;
  text-align: center;
  color: #78716c;
  font-size: 28rpx;
  white-space: pre-line;
}

.state-error {
  color: #b45309;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 32rpx rgba(11, 18, 32, 0.05);
}

.card-locked {
  opacity: 0.62;
}

.card-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.card-text {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.badge-new {
  flex-shrink: 0;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: #e11d48;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.summary {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #78716c;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.thumb-wrap {
  position: relative;
  flex-shrink: 0;
}

.thumb {
  width: 148rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #e7e5e4;
}

.thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a8a29e;
  font-size: 28rpx;
  font-weight: 700;
}

.progress {
  position: absolute;
  right: -8rpx;
  bottom: -10rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  background: #0f766e;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
}

.chip {
  font-size: 20rpx;
  color: #57534e;
  background: #f5f5f4;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.chip-star {
  color: #b45309;
  background: #fff7ed;
}
