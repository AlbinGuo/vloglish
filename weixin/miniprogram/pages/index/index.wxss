.page {
  padding: 24rpx 28rpx 48rpx;
}

.hero {
  padding: 12rpx 8rpx 32rpx;
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: #737373;
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.hero-lead {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #525252;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #737373;
  font-size: 28rpx;
}

.state-error {
  color: #b45309;
}

.card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(11, 18, 32, 0.06);
}

.cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #e7e5e4;
}

.card-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
}

.meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.source {
  font-size: 22rpx;
  color: #78716c;
}

.badge {
  font-size: 20rpx;
  color: #0f766e;
  background: #ccfbf1;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.summary {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #57534e;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.stars {
  letter-spacing: 2rpx;
  color: #b45309;
}
