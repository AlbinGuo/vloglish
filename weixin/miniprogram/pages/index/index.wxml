<view class="page">
  <view class="bg" aria-hidden="true">
    <view class="mesh"></view>
    <view class="orb a"></view>
    <view class="orb b"></view>
    <view class="orb c"></view>
    <view class="ring a"></view>
    <view class="ring b"></view>
    <view class="spark s1"></view>
    <view class="spark s2"></view>
    <view class="spark s3"></view>
    <view class="spark s4"></view>
    <view class="spark s5"></view>
    <view class="spark s6"></view>
  </view>

  <view class="site">
    <text class="site-lead">长按下方地址，复制后到浏览器打开</text>
    <view class="site-row">
      <text class="site-url" selectable>{{siteUrl}}</text>
      <text class="site-hint">长按复制</text>
    </view>
  </view>

  <view class="block">
    <text class="h">会员档位</text>
    <view class="plans">
      <view class="plan {{item.hot ? 'is-hot' : ''}}" wx:for="{{plans}}" wx:key="name">
        <text class="plan-name">{{item.name}}</text>
        <view class="plan-price-row">
          <text class="yen">¥</text>
          <text class="plan-price">{{item.price}}</text>
        </view>
        <text class="plan-note">{{item.note}}</text>
      </view>
    </view>
    <button class="ghost" bindtap="onOpenMember">去选择套餐</button>
  </view>
</view>
