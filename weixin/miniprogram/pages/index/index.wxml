<view class="page">
  <view class="hero">
    <text class="hero-kicker">Vloglish</text>
    <text class="hero-title">读报</text>
    <text class="hero-lead">真实语料分段阅读，先听懂生活里的英语。</text>
  </view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state state-error" bindtap="reload">{{error}}，点此重试</view>
  <view wx:elif="{{empty}}" class="state">暂无已发布文章</view>

  <view wx:else class="list">
    <view
      class="card"
      wx:for="{{articles}}"
      wx:key="article_id"
      data-id="{{item.article_id}}"
      bindtap="onOpenArticle"
    >
      <image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="card-body">
        <view class="meta">
          <text wx:if="{{item.source}}" class="source">{{item.source}}</text>
          <text wx:if="{{item.is_new}}" class="badge">新</text>
        </view>
        <text class="title">{{item.title}}</text>
        <text wx:if="{{item.summary}}" class="summary">{{item.summary}}</text>
        <view class="foot">
          <text class="stars">{{item.starsLabel}}</text>
          <text class="words" wx:if="{{item.word_count}}">{{item.word_count}} 词</text>
        </view>
      </view>
    </view>
  </view>
</view>
