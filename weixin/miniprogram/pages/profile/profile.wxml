<view class="page">
  <view class="hero">
    <view class="hero-row">
      <view class="avatar">{{initial}}</view>
      <view class="hero-info">
        <text class="name">{{name}}</text>
        <text class="role">{{memberLabel}}</text>
      </view>
    </view>

    <button
      wx:if="{{!loggedIn}}"
      class="login-btn"
      loading="{{loading}}"
      bindtap="onLogin"
    >微信一键登录</button>

    <view wx:elif="{{!isMember}}" class="member-cta" bindtap="onMembership">
      <text class="cta-kicker">会员权益</text>
      <text class="cta-title">季度 / 年度 / 永久三档</text>
      <text class="cta-go">去开通</text>
    </view>
  </view>

  <view class="group">
    <text class="group-label">学习</text>
    <view class="cell last" bindtap="onVocab">
      <text class="cell-title">生词本</text>
      <text class="cell-sub">{{loggedIn ? (vocabCount + ' 个词') : '登录后查看'}}</text>
    </view>
  </view>

  <view class="group">
    <text class="group-label">服务</text>
    <view class="cell" bindtap="onMembership">
      <text class="cell-title">{{isMember ? '会员权益' : '开通会员'}}</text>
      <text class="cell-sub">季度 29 · 年度 59 · 永久 99</text>
    </view>
    <block wx:if="{{showBindAccount}}">
      <view wx:if="{{wechatOnly}}" class="cell" bindtap="onBindEmail">
        <text class="cell-title">关联网页账号</text>
        <text class="cell-sub">备用：填邮箱密码，或去电脑扫关联码</text>
      </view>
      <view wx:elif="{{wxBound && emailLabel}}" class="cell">
        <text class="cell-title">已关联网页</text>
        <text class="cell-sub">{{emailLabel}}</text>
      </view>
    </block>
    <view class="cell" bindtap="onFeedback">
      <text class="cell-title">意见反馈</text>
      <text class="cell-sub">告诉我们哪里不好用</text>
    </view>
    <view class="cell" data-type="terms" bindtap="onLegal">
      <text class="cell-title">用户协议</text>
    </view>
    <view class="cell last" data-type="privacy" bindtap="onLegal">
      <text class="cell-title">隐私政策</text>
    </view>
  </view>

  <button wx:if="{{loggedIn}}" class="logout-btn" bindtap="onLogout">退出登录</button>
</view>
