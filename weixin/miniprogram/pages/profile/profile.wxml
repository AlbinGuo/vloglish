<view class="wrap">
  <view class="profile">
    <view class="avatar">{{loggedIn ? '我' : '?'}}</view>
    <view class="profile-info">
      <text class="name">{{name}}</text>
      <text class="muted">{{memberLabel}}</text>
    </view>
  </view>

  <button
    wx:if="{{!loggedIn}}"
    class="login-btn"
    loading="{{loading}}"
    bindtap="onLogin"
  >微信一键登录</button>

  <view class="block">
    <text class="block-title">说明</text>
    <text class="hint">登录后与网站同一账号体系。首页先开放读报列表；视频精听跟读随后接入。</text>
  </view>

  <button wx:if="{{loggedIn}}" class="logout-btn" bindtap="onLogout">退出登录</button>
</view>
