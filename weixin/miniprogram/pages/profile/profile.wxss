.wrap {
  padding: 8rpx 0 48rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 32rpx 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #0b1220;
  color: #f4f1ea;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-info .muted {
  display: block;
  margin-top: 8rpx;
  color: #737373;
  font-size: 26rpx;
}

.login-btn {
  margin: 8rpx 32rpx 0;
  background: #0b1220;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.block {
  padding: 40rpx 32rpx 16rpx;
}

.block-title {
  display: block;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hint {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: #57534e;
}

.logout-btn {
  margin-top: 48rpx;
  background: transparent;
  color: #dc2626;
  font-size: 28rpx;
}

.logout-btn::after {
  border: none;
}
