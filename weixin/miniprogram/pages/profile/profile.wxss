.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 24rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f5f5f4;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-info .muted {
  display: block;
  margin-top: 8rpx;
  color: #737373;
  font-size: 26rpx;
}

.login-btn {
  margin-top: 20rpx;
}

.stats {
  display: flex;
  padding: 24rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.block {
  padding: 24rpx;
}

.block-title {
  display: block;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.input {
  background: #f5f5f4;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.link-btn {
  background: transparent;
  color: #171717;
  font-size: 28rpx;
}

.link-btn::after {
  border: none;
}

.logout-btn {
  background: transparent;
  color: #dc2626;
  font-size: 28rpx;
}

.logout-btn::after {
  border: none;
}
