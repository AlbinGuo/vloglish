<view class="page">
  <view class="hero">
    <text class="kicker">MEMBERSHIP</text>
    <text class="title">会员权益</text>
  </view>

  <view wx:if="{{isMember}}" class="banner">{{memberHint}}</view>

  <view class="plans">
    <view
      class="plan {{item.selected ? 'is-on' : ''}} {{item.recommended ? 'is-hot' : ''}}"
      wx:for="{{plans}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <view class="plan-top">
        <view>
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-period">{{item.period}}</text>
        </view>
        <view class="plan-price-wrap">
          <text class="yen">¥</text>
          <text class="plan-price">{{item.price}}</text>
        </view>
      </view>
      <view class="plan-bottom">
        <text class="plan-note">{{item.note}}</text>
        <text wx:if="{{item.recommended}}" class="badge">推荐</text>
        <text wx:elif="{{item.selected}}" class="pick">已选</text>
      </view>
    </view>
  </view>

  <button class="buy" loading="{{paying}}" bindtap="onBuy">开通所选套餐</button>

  <view class="card muted">
    <text class="h">已有激活码</text>
    <input class="input" placeholder="输入激活码" value="{{code}}" bindinput="onCode" />
    <button class="ghost" loading="{{submitting}}" bindtap="onActivate">用激活码开通</button>
  </view>
</view>
