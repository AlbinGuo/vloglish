# 从 teco-lab.com 拉取 /english 目录（import_english_episodes.py 用，勿提交）
# TECO_EMAIL=your_username
# TECO_PASSWORD=your_password

# 七牛云对象存储（勿提交真实密钥）
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key
QINIU_BUCKET=sxak-oss
QINIU_DOMAIN=http://oss.sxakgs.com
QINIU_PREFIX=en

# DeepSeek 查词（勿提交真实密钥）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LOOKUP_CACHE_TTL_DAYS=30

# JWT（生产环境务必更换 JWT_SECRET）
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# 管理后台默认账号（启动时自动创建/更新）
ADMIN_EMAIL=admin@vloglish.com
ADMIN_PASSWORD=admin123456

# 前端地址（用于密码重置链接）
FRONTEND_URL=http://127.0.0.1:5173
APP_DEBUG=true

# 可选：SMTP 发信（配置后将通过邮件发送重置链接）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@vloglish.com
# SMTP_USE_TLS=true
