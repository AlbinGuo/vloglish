# 从 teco-lab.com 拉取 /english 目录（管理端或 CLI 脚本用，勿提交）
# TECO_EMAIL=your_username
# TECO_PASSWORD=your_password
# TECO_ACCESS_TOKEN=eyJ...
# TECO_DEVICE_ID=与浏览器 localStorage.device_id 一致

# 视频处理：默认去除 teco 原站水印，不叠加 vloglish 文字（设为 true 可恢复旧行为）
# VLOGISH_STRIP_SOURCE_WATERMARK=true
# VLOGISH_ADD_WATERMARK=false
# VLOGISH_DELOGO_X=0
# VLOGISH_DELOGO_Y=0
# VLOGISH_DELOGO_W=455
# VLOGISH_DELOGO_H=52
# 左下角 Ep.NNN 期数角标（delogo + 毛玻璃遮罩，不加新文字）
# VLOGISH_DELOGO_BL_W=175
# VLOGISH_DELOGO_BL_H=38
# VLOGISH_DELOGO_BL_MARGIN=10
# VLOGISH_DELOGO_BL_X=0
# VLOGISH_WATERMARK_BAR_W=455
# VLOGISH_WATERMARK_TEXT_W=140
# VLOGISH_WATERMARK_H=52
# VLOGISH_WATERMARK_BLUR_LR=12
# VLOGISH_WATERMARK_TINT=0.22
# VLOGISH_WATERMARK_TEXT=vloglish
# VLOGISH_FONT_FILE=C:/Windows/Fonts/segoeuib.ttf

# 本机素材工具（yt-dlp / ffmpeg，管理端抓取用）
VLOGISH_TOOLS_DIR=E:\vloglish
# YT_DLP_BIN=E:\vloglish\yt-dlp.exe
# FFMPEG_DIR=E:\vloglish
# YT_DLP_COOKIES=E:\vloglish\cookies.txt
# YT_DLP_TIMEOUT=900
# 国内网络抓取 YouTube/TikTok 需代理（Clash/V2Ray 的 HTTP 端口，如 7890、61906）
# YT_DLP_PROXY=http://127.0.0.1:61906

# 七牛云对象存储（勿提交真实密钥）
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key
QINIU_BUCKET=sxak-oss
QINIU_DOMAIN=http://oss.sxakgs.com
QINIU_PREFIX=en

# 七牛上传超时（秒，大视频建议 600+；勿走 VPN 代理）
# QINIU_UPLOAD_TIMEOUT=600

# 段落 TTS（默认 Qwen DashScope；可选 azure）
TTS_PROVIDER=qwen
DASHSCOPE_API_KEY=sk-xxx
# 北京默认端点；若使用业务空间专属 URL，可设 DASHSCOPE_TTS_URL
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Ryan
QWEN_TTS_LANGUAGE=English
# 使用 qwen3-tts-instruct-flash 时可开启播报风格指令
# QWEN_TTS_INSTRUCTIONS=Read like a calm news anchor, clear and steady.
# QWEN_TTS_OPTIMIZE_INSTRUCTIONS=true

# Azure TTS（TTS_PROVIDER=azure 时使用）
# AZURE_SPEECH_KEY=your_speech_key
# AZURE_SPEECH_REGION=chinaeast2
# AZURE_SPEECH_VOICE=en-US-JennyNeural

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LOOKUP_CACHE_TTL_DAYS=30

# PostgreSQL（Docker / 无 db_switch.py 时使用；本地开发推荐用 db_switch.py 切库，见 docs/DEV_DATABASE.md）
# DATABASE_URL=postgresql+psycopg://postgres:your_url_encoded_password@localhost:5432/postgres

# JWT（生产环境务必更换 JWT_SECRET）
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# 管理后台默认账号（启动时自动创建/更新）
ADMIN_EMAIL=admin@vloglish.com
ADMIN_PASSWORD=admin123456

# 前端地址（用于密码重置链接）
FRONTEND_URL=http://127.0.0.1:5173
APP_DEBUG=true

# 可选：SMTP 发信（配置后将通过邮件发送重置链接）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@vloglish.com
# SMTP_USE_TLS=true
