{
  "name": "vloglish-app",
  "private": true,
  "version": "0.1.0",
  "description": "Vloglish Capacitor 原生壳（iOS / Android）",
  "scripts": {
    "build:web": "npm --prefix ../frontend run build:app-assets",
    "assets:generate": "python scripts/generate-brand-assets.py",
    "sync": "npm run build:web && npx @capacitor/cli sync",
    "build:apk": "npm run sync && node scripts/run-android-assemble.mjs && node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk','dist/vloglish-debug.apk');console.log('APK -> dist/vloglish-debug.apk')\"",
    "open:android": "npx @capacitor/cli open android",
    "open:ios": "npx @capacitor/cli open ios",
    "add:android": "npx @capacitor/cli add android",
    "add:ios": "npx @capacitor/cli add ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "cordova-plugin-purchase": "^13.19.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "~5.7.2"
  }
}
